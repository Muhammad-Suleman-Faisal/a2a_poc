# Copy to .env and replace placeholders before enabling IAM.
GEMINI_API_KEY=
IAM_ENABLED=false
IAM_DB_PATH=auth/iam.db
IAM_ISSUER=a2a-poc-iam
IAM_TOKEN_SECRET=replace-with-a-long-random-secret
IAM_ADMIN_USERNAME=admin
IAM_ADMIN_PASSWORD=replace-admin-password
IAM_USER_USERNAME=user
IAM_USER_PASSWORD=replace-user-password
IAM_VIEWER_USERNAME=viewer
IAM_VIEWER_PASSWORD=replace-viewer-password
CLIENT_AGENT_ID=client-agent
CLIENT_AGENT_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:9000
DASHBOARD_ORIGIN=http://localhost:5173
